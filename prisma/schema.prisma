// Filtre Maroc — database schema (Supabase Postgres via Prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  categorySlug     String
  shortDescription String   @default("")
  description      String   @default("")
  price            Int
  oldPrice         Int?
  rating           Float    @default(0)
  reviewCount      Int      @default(0)
  stages           Int?
  capacity         String?
  warranty         String?
  badges           String[] @default([])
  inStock          Boolean  @default(true)
  stock            Int      @default(0)
  allowBackorder   Boolean  @default(false) // "sur commande": orderable even at 0 stock
  bestSeller       Boolean  @default(false)
  hue              Int      @default(205)
  images           String[] @default([])
  features         String[] @default([])
  specs            Json     @default("[]")
  variants         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([categorySlug])
}

model Order {
  id               String    @id
  customerName     String
  phone            String
  city             String
  address          String
  note             String?
  items            Json      @default("[]")
  total            Int
  status           String    @default("pending")
  confirmationNote String?
  source           String    @default("web") // "web" | "phone"
  confirmedAt      DateTime?
  installDate      DateTime? // scheduled installation date/time
  assignedTo       String? // plombier email the job is assigned to
  completedAt      DateTime? // when the plombier marked it installed
  photoUrl         String? // completion photo uploaded by the plombier
  installStage     String? // plombier progress: "enroute" | "arrived" (null = scheduled)
  kind             String    @default("install") // "install" | "maintenance"
  parentOrderId    String? // for a maintenance visit: the original installation
  lastOutcome      String? // last confirmation-call result: "confirmed"|"rappeler"|"pas_reponse"|"cancelled"
  callAttempts     Int       @default(0) // number of confirmation-call attempts logged
  warrantyMonths   Int       @default(24) // warranty length from completion
  maintenanceMonths Int      @default(6) // months between maintenance visits
  nextMaintenanceAt DateTime? // when the next filter change is due
  lastMaintenanceAt DateTime? // last maintenance done
  createdAt        DateTime  @default(now())

  @@index([status])
  @@index([assignedTo])
  @@index([kind])
  @@index([nextMaintenanceAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("admin") // "admin" | "confirmateur" | "plombier"
  city         String? // plombier coverage city/zone (for dispatch)
  createdAt    DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
}

model RateLimit {
  key     String   @id // e.g. "order:<ip>", "login:<ip>", "contact:<ip>"
  count   Int      @default(0)
  resetAt DateTime
}

model SiteSettings {
  id                     String   @id @default("main")
  siteName               String   @default("Filtre Maroc")
  logoUrl                String?
  phone1                 String   @default("")
  phone2                 String?
  email                  String?
  whatsapp               String?
  addressText            String?
  mapLat                 Float?
  mapLng                 Float?
  facebook               String?
  instagram              String?
  tiktok                 String?
  announcement           String?
  freeDeliveryThreshold  Int      @default(1000)
  deliveryFee            Int      @default(40)
  updatedAt              DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  productId String
  name      String
  rating    Int // 1-5 stars
  comment   String
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())

  @@index([productId, status])
  @@index([status])
}

// CRM customer record — auto-upserted from every order, keyed by normalized phone.
// Order aggregates (count, spend, last order) are computed live from Order.
model Client {
  id           String   @id @default(cuid())
  phone        String   @unique // normalized identity (digits, 0XXXXXXXXX)
  name         String
  city         String   @default("")
  email        String?
  address      String?
  source       String   @default("web") // "web" | "phone"
  status       String   @default("active") // "active" | "inactive"
  note         String?
  firstOrderAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([city])
}

// Audit trail — every meaningful action in the system, for the admin "activity" feed.
model ActivityLog {
  id        String   @id @default(cuid())
  actor     String   @default("system") // email, "customer", or "system"
  action    String // "order.created" | "order.confirmed" | "order.status" | "order.installed" | "review.created" | "review.moderated" | "client.status" | "settings.updated"
  entity    String? // related id (order id, client phone, …)
  summary   String // human-readable one-liner (already localized at write time is avoided; store neutral text)
  meta      Json? // extra structured data
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}
