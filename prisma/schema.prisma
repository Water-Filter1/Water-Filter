// Filtre Maroc — database schema (Supabase Postgres via Prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  categorySlug     String
  shortDescription String   @default("")
  description      String   @default("")
  price            Int
  cost             Int      @default(0) // unit purchase cost (for COGS / real profit)
  oldPrice         Int?
  rating           Float    @default(0)
  reviewCount      Int      @default(0)
  stages           Int?
  capacity         String?
  warranty         String?
  badges           String[] @default([])
  inStock          Boolean  @default(true)
  stock            Int      @default(0)
  reorderPoint     Int      @default(5) // alert/reorder threshold (per product)
  allowBackorder   Boolean  @default(false) // "sur commande": orderable even at 0 stock
  bestSeller       Boolean  @default(false)
  hue              Int      @default(205)
  images           String[] @default([])
  features         String[] @default([])
  specs            Json     @default("[]")
  variants         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  movements        StockMovement[]

  @@index([categorySlug])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Int      // signed change: + in, - out
  before    Int
  after     Int
  reason    String   // received | correction | damaged | return | sale | maintenance
  note      String?
  actor     String?  // email of who made the change
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model Order {
  id               String    @id
  customerName     String
  phone            String
  city             String
  address          String
  note             String?
  items            Json      @default("[]")
  total            Int
  status           String    @default("pending")
  confirmationNote String?
  source           String    @default("web") // "web" | "phone"
  acquisitionSource String?  // how the customer found us: facebook | tiktok | instagram | google | referral | other
  confirmedAt      DateTime?
  confirmedBy      String? // confirmateur email who confirmed / cancelled (for performance)
  installDate      DateTime? // scheduled installation date/time
  assignedTo       String? // plombier email the job is assigned to
  completedAt      DateTime? // when the plombier marked it installed
  photoUrl         String? // completion photo uploaded by the plombier
  installStage     String? // plombier progress: "enroute" | "arrived" (null = scheduled)
  kind             String    @default("install") // "install" | "maintenance"
  parentOrderId    String? // for a maintenance visit: the original installation
  lastOutcome      String? // last confirmation-call result: "confirmed"|"rappeler"|"pas_reponse"|"cancelled"
  callAttempts     Int       @default(0) // number of confirmation-call attempts logged
  warrantyMonths   Int       @default(24) // warranty length from completion
  maintenanceMonths Int      @default(6) // months between maintenance visits
  nextMaintenanceAt DateTime? // when the next filter change is due
  lastMaintenanceAt DateTime? // last maintenance done
  createdAt        DateTime  @default(now())

  @@index([status])
  @@index([assignedTo])
  @@index([kind])
  @@index([nextMaintenanceAt])
  @@index([confirmedBy])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("admin") // "admin" | "confirmateur" | "plombier"
  city         String? // plombier coverage city/zone (for dispatch)
  commissionPerInstall Int @default(0) // MAD paid to this technician per completed install
  createdAt    DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
}

model RateLimit {
  key     String   @id // e.g. "order:<ip>", "login:<ip>", "contact:<ip>"
  count   Int      @default(0)
  resetAt DateTime
}

model SiteSettings {
  id                     String   @id @default("main")
  siteName               String   @default("Filtre Maroc")
  logoUrl                String?
  phone1                 String   @default("")
  phone2                 String?
  email                  String?
  whatsapp               String?
  addressText            String?
  mapLat                 Float?
  mapLng                 Float?
  facebook               String?
  instagram              String?
  tiktok                 String?
  announcement           String?
  freeDeliveryThreshold  Int      @default(1000)
  deliveryFee            Int      @default(40)
  confirmateurMonthly    Int      @default(0) // fixed monthly pay for the confirmateur (operating expense)
  updatedAt              DateTime @updatedAt
}

// A customer facture (sales receipt). Generated from an order; data is SNAPSHOT at
// issue time so later edits to the order never change an issued facture. No TVA — the
// business issues a simple receipt (items + delivery + one total, paid on delivery).
model Invoice {
  id              String   @id @default(cuid())
  number          Int      @unique // global sequential value from InvoiceCounter
  ref             String   @unique // display reference, e.g. "FAC-00001"
  orderId         String?  @unique // source order — one facture per order (DB-enforced)
  customerName    String
  customerPhone   String   @default("")
  customerCity    String   @default("")
  customerAddress String   @default("")
  items           Json     @default("[]") // snapshot: [{ name, qty, price, total }]
  subtotal        Int      @default(0) // sum of line totals
  deliveryFee     Int      @default(0) // total - subtotal (delivery / adjustment)
  total           Int      @default(0) // grand total the client pays
  status          String   @default("issued") // "issued" | "cancelled"
  note            String?
  issuedBy        String? // admin email who generated it
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

// Single-row counter for gap-free sequential invoice numbers (atomic increment).
model InvoiceCounter {
  id   String @id @default("default")
  next Int    @default(0)
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  name        String
  rating      Int // 1-5 stars
  comment     String
  status      String   @default("pending") // pending | approved | rejected
  clientPhone String? // normalized phone, set when the reviewer matches a known client
  createdAt   DateTime @default(now())

  @@index([productId, status])
  @@index([status])
  @@index([clientPhone])
}

// CRM customer record — auto-upserted from every order, keyed by normalized phone.
// Order aggregates (count, spend, last order) are computed live from Order.
model Client {
  id           String   @id @default(cuid())
  phone        String   @unique // normalized identity (digits, 0XXXXXXXXX)
  name         String
  city         String   @default("")
  email        String?
  address      String?
  source       String   @default("web") // "web" | "phone"
  status       String   @default("active") // "active" | "inactive"
  note         String?
  tags         String[] @default([]) // freeform CRM labels: VIP, grossiste, mauvais payeur…
  acquisitionSource String? // marketing channel the customer came from (set on first order)
  whatsappOptIn Boolean @default(false) // consented to WhatsApp/SMS marketing
  firstOrderAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([city])
}

// Timestamped CRM notes / interaction log per client (joined by normalized phone, like orders).
model ClientNote {
  id          String   @id @default(cuid())
  clientPhone String // normalized phone (matches Client.phone)
  body        String
  author      String   @default("admin") // admin email who wrote it
  createdAt   DateTime @default(now())

  @@index([clientPhone])
}

// Audit trail — every meaningful action in the system, for the admin "activity" feed.
model ActivityLog {
  id        String   @id @default(cuid())
  actor     String   @default("system") // email, "customer", or "system"
  action    String // "order.created" | "order.confirmed" | "order.status" | "order.installed" | "review.created" | "review.moderated" | "client.status" | "settings.updated"
  entity    String? // related id (order id, client phone, …)
  summary   String // human-readable one-liner (already localized at write time is avoided; store neutral text)
  meta      Json? // extra structured data
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

// Daily snapshot of point-in-time metrics (stock, queues, clients) so the dashboard
// KPI cards can show a real trend over time. One row per day, upserted on dashboard load.
model MetricSnapshot {
  id               String   @id @default(cuid())
  day              DateTime @unique // midnight (local) of the snapshot day
  stockTotal       Int      @default(0)
  lowStockCount    Int      @default(0)
  pending          Int      @default(0)
  savDue           Int      @default(0)
  activeClients    Int      @default(0)
  installedDevices Int      @default(0)
  technicians      Int      @default(0)
  createdAt        DateTime @default(now())
}

// Business expenses — so the dashboard can show real Dépenses and Profit net.
model Expense {
  id        String   @id @default(cuid())
  label     String
  category  String   @default("other") // "stock" | "ads" | "rent" | "salary" | "delivery" | "other"
  amount    Int // MAD
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([date])
  @@index([category])
}

// First-party storefront analytics — one row per public page view. Privacy-light: only an
// anonymous random visitor id (cookie), no name/phone/IP stored. Powers the admin Analytics
// dashboard (visitors, traffic source, device, top products, funnel).
model PageView {
  id          String   @id @default(cuid())
  visitorId   String // anonymous first-party id (cookie) for unique-visitor counting
  path        String // e.g. "/product/karofi-u65"
  type        String   @default("page") // "page" | "product"
  productSlug String? // set when type = "product"
  source      String   @default("direct") // facebook | instagram | tiktok | google | referral | direct
  device      String   @default("desktop") // mobile | tablet | desktop
  country     String? // ISO-2, best-effort from edge geo headers
  referrer    String? // referrer host (diagnostics only)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([type])
  @@index([source])
  @@index([productSlug])
  @@index([visitorId])
}
